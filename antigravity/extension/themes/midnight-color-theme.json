  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6b6590", "fontStyle": "italic" } },
    { "scope": ["comment.block.documentation", "comment.line.documentation", "comment.block.javadoc"],
      "settings": { "foreground": "#7f77a8", "fontStyle": "italic" } },
    { "scope": ["storage.type.class.doxygen", "storage.type.class.jsdoc", "keyword.other.doxygen", "entity.name.tag.documentation"],
      "settings": { "foreground": "#f472b6", "fontStyle": "italic" } },

    { "scope": ["string", "punctuation.definition.string", "string.quoted", "string.template"],
      "settings": { "foreground": "#c3e88d" } },
    { "scope": ["constant.character.escape", "constant.other.placeholder", "string.regexp"],
      "settings": { "foreground": "#89ddff" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other.enum", "variable.other.enummember"],
      "settings": { "foreground": "#fbbf24" } },

    { "scope": ["keyword", "keyword.control", "storage", "storage.modifier", "keyword.other.using", "keyword.other.namespace",
                "variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": { "foreground": "#c792ea" } },
    { "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.namespace", "keyword.operator.arrow"],
      "settings": { "foreground": "#89ddff" } },
    { "scope": ["keyword.operator.new", "keyword.operator.delete", "keyword.operator.sizeof", "keyword.operator.expression",
                "keyword.operator.logical.python", "keyword.operator.wordlike"],
      "settings": { "foreground": "#c792ea" } },
    { "scope": ["storage.type.primitive", "storage.type.built-in", "support.type.primitive", "storage.type.numeric",
                "storage.type.boolean", "support.type.builtin", "keyword.type"],
      "settings": { "foreground": "#82aaff" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.union",
                "entity.other.inherited-class", "support.class", "support.type", "entity.name.namespace", "entity.name.scope-resolution",
                "storage.type.cs", "storage.type.java"],
      "settings": { "foreground": "#89ddff" } },

    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
      "settings": { "foreground": "#c4b5fd" } },
    { "scope": ["meta.function.definition entity.name.function", "meta.definition.function entity.name.function",
                "meta.function entity.name.function", "entity.name.function.definition"],
      "settings": { "foreground": "#c4b5fd", "fontStyle": "bold" } },

    { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#dcd6f2" } },
    { "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#e6e0f8", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.member", "variable.other.object.property", "support.variable.property",
                "entity.name.variable.field", "meta.object-literal.key"],
      "settings": { "foreground": "#b9b2e0" } },
    { "scope": ["variable.other.constant", "variable.other.global", "variable.language.special"],
      "settings": { "foreground": "#f0abfc" } },

    { "scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive", "entity.name.function.preprocessor",
                "entity.name.function.macro", "keyword.control.import", "keyword.control.include"],
      "settings": { "foreground": "#f78cb0" } },
    { "scope": ["meta.attribute", "entity.name.function.decorator", "meta.decorator", "punctuation.definition.decorator",
                "storage.type.annotation", "punctuation.definition.annotation", "meta.annotation"],
      "settings": { "foreground": "#f78cb0", "fontStyle": "italic" } },
    { "scope": ["entity.name.label", "entity.name.goto-label"],
      "settings": { "foreground": "#fbbf24" } },

    { "scope": ["punctuation", "meta.brace", "punctuation.terminator", "punctuation.separator"],
      "settings": { "foreground": "#8c84ae" } },

    { "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#c792ea" } },
    { "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#89ddff", "fontStyle": "italic" } },
    { "scope": ["support.type.property-name", "support.type.property-name.json"],
      "settings": { "foreground": "#b9b2e0" } },
    { "scope": ["support.constant.property-value", "support.constant.color", "keyword.other.unit"],
      "settings": { "foreground": "#fbbf24" } },
    { "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css"],
      "settings": { "foreground": "#c4b5fd", "fontStyle": "" } },

    { "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#c792ea", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#f0abfc", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#f0abfc", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#c3e88d" } },
    { "scope": ["markup.underline.link", "string.other.link", "markup.link"], "settings": { "foreground": "#67e8f9" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#a29ac7", "fontStyle": "italic" } },
    { "scope": ["markup.list punctuation.definition.list"], "settings": { "foreground": "#f472b6" } },
    { "scope": ["markup.inserted", "punctuation.definition.inserted"], "settings": { "foreground": "#c3e88d" } },
    { "scope": ["markup.deleted", "punctuation.definition.deleted"], "settings": { "foreground": "#fb7185" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["meta.diff.header", "meta.diff.range"], "settings": { "foreground": "#a78bfa" } },

    { "scope": ["support.function.be.latex", "support.function.general.tex", "support.function.section.latex", "support.function.textbf.latex",
                "support.function.emph.latex", "support.function.textit.latex", "support.function.texttt.latex", "support.function.url.latex"],
      "settings": { "foreground": "#c792ea" } },
    { "scope": ["keyword.control.preamble.latex", "keyword.control.cite.latex", "keyword.control.ref.latex", "keyword.control.label.latex",
                "keyword.control.newline.tex", "keyword.control.equation.align.latex"],
      "settings": { "foreground": "#f78cb0" } },
    { "scope": ["variable.parameter.function.latex", "constant.other.reference.latex", "constant.other.citation.latex",
                "entity.name.function.environment.latex", "variable.parameter.definition.label.latex"],
      "settings": { "foreground": "#89ddff", "fontStyle": "" } },
    { "scope": ["string.other.math", "meta.math.block", "markup.other.math", "support.class.math"],
      "settings": { "foreground": "#c3e88d" } },

    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ffffff" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "#fbbf24", "fontStyle": "strikethrough" } }
  ],

  "semanticTokenColors": {
    "namespace": "#89ddff",
    "type": "#89ddff",
    "class": "#89ddff",
    "struct": "#89ddff",
    "interface": "#89ddff",
    "enum": "#89ddff",
    "typeParameter": { "foreground": "#89ddff", "italic": true },
    "concept": "#89ddff",
    "enumMember": "#fbbf24",
    "function": "#c4b5fd",
    "method": "#c4b5fd",
    "function.declaration": { "foreground": "#c4b5fd", "bold": true },
    "method.declaration": { "foreground": "#c4b5fd", "bold": true },
    "method.virtual": { "foreground": "#c4b5fd", "italic": true },
    "macro": "#f78cb0",
    "decorator": { "foreground": "#f78cb0", "italic": true },
    "label": "#fbbf24",
    "variable": "#dcd6f2",
    "variable.readonly": "#dcd6f2",
    "variable.globalScope": "#f0abfc",
    "variable.static": { "foreground": "#f0abfc", "italic": true },
    "variable.defaultLibrary": "#dcd6f2",
    "parameter": { "foreground": "#e6e0f8", "italic": true },
    "property": "#b9b2e0",
    "property.static": { "foreground": "#f0abfc", "italic": true },
    "operator": "#89ddff",
    "operatorOverload": "#89ddff",
    "keyword": "#c792ea",
    "number": "#fbbf24",
    "string": "#c3e88d",
    "comment": { "foreground": "#6b6590", "italic": true },
    "*.deprecated": { "strikethrough": true }
  }
}
